#!/usr/bin/env python
import os

env = SConscript('godot-cpp/SConstruct').Clone()
env.Append(CPPPATH=['third-party'])
# nlohmann JSON reports malformed saved patches through exceptions.
env.Append(CXXFLAGS=['-fexceptions', '-fno-gnu-unique', '-fvisibility=hidden'])
env.Append(LINKFLAGS=['-Wl,-Bsymbolic', '-Wl,--exclude-libs,ALL'])
Default(env.SharedLibrary('bin/libuntilthen' + env['suffix'] + env['SHLIBSUFFIX'], ['replacements.cpp']))
